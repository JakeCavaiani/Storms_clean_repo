xlab("") +
ylab("ß") +
theme_bw() +
facet_wrap(~response_var) +
geom_text(data = annotations,
aes(x = x_position, y = y_position, label = Label),
inherit.aes = FALSE, size = 6) +
guides(fill = "none",
pattern = guide_legend(override.aes = list(fill = "white"))) +
theme_classic() +
theme(legend.position = "bottom")
