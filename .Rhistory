columns = c("SLOPE_MEAN", "cburntot", "orgsoil_extent", "pctburn_lg", "Pf_Prob_1m_mean_x", "NDVI_p50__mean_abs_change", "NDVI_p50__mean_second_derivative_central",  "NDVI_p50__mean", "NDVI_p50__standard_deviation", "NDVIave", "pfrost", "deciduous2010", "deciduous2016", "deciduous2020", "evergreen" ),
ggplot2::aes())
library(tidyverse)
library(MuMIn)
library(ggeffects)
library(dotwhisker)
library(lme4)
library(AICcmodavg)
install.packages("MuMIn")
install.packages("ggeffects")
install.packages("lme4")
library(here)
install.packages("viridis")
install.packages("broom")
AMC <- read.csv(here("Output_from_analysis", "compare_JSC_ATW_storm_totals", "updated_AMC_HI_BETA_file_2509.csv"))
AMC <- AMC %>% mutate(date = as.Date(date, format = "%Y-%m-%d")) %>%
mutate(year = format(date, "%Y"))
# scale & standardize predictors #
# add hard code ln-HI & beta for use w/ ggparis plotting
varnames <- c("precip.week", "precip.month", "ThreeMonth", "Intensity", "TimeSinceChena")
AMC <- AMC %>% mutate(across(starts_with(varnames), ~as.numeric(scale (., center = TRUE, scale = TRUE)), .names = "{.col}_z")) %>%
mutate(across(TimeSinceChena), ~as.numeric(scale(., center = TRUE, scale = FALSE)), names = "{.col}_cent") %>%
mutate(ln_HI = log(Hyst_index + 1)) %>%
mutate(ln_beta = log(Beta_index + 7))
AMC <- AMC %>% mutate(across(starts_with(varnames), ~as.numeric(scale (., center = TRUE, scale = TRUE)), .names = "{.col}_z")) %>%
mutate(TimeSinceChena, ~as.numeric(scale(., center = TRUE, scale = FALSE)), names = "{.col}_cent") %>%
mutate(ln_HI = log(Hyst_index + 1)) %>%
mutate(ln_beta = log(Beta_index + 7))
AMC <- AMC %>% mutate(across(starts_with(varnames), ~as.numeric(scale (., center = TRUE, scale = TRUE)), .names = "{.col}_z")) %>%
mutate(TimeSinceChena_cent, = ~as.numeric(scale(., center = TRUE, scale = FALSE))) %>%
AMC <- AMC %>% mutate(across(starts_with(varnames), ~as.numeric(scale (., center = TRUE, scale = TRUE)), .names = "{.col}_z")) %>%
mutate(TimeSinceChena_cent = ~as.numeric(scale(., center = TRUE, scale = FALSE))) %>%
mutate(ln_HI = log(Hyst_index + 1)) %>%
mutate(ln_beta = log(Beta_index + 7))
AMC <- AMC %>% mutate(across(starts_with(varnames), ~as.numeric(scale (., center = TRUE, scale = TRUE)), .names = "{.col}_z")) %>%
mutate(TimeSinceChena_cent = as.numeric(scale(TimeSinceChena, center = TRUE, scale = FALSE))) %>%
mutate(ln_HI = log(Hyst_index + 1)) %>%
mutate(ln_beta = log(Beta_index + 7))
head(AMC)
# MOOS #
pairs <- AMC %>% filter(site.ID == "MOOS" & response_var == "NO3") %>%
ggpairs(columns = c("precip.week_z", "precip.month_z", "ThreeMonth_z", "Intensity_z", "TimeSinceChena_cent", "ln_HI"), mapping = aes(color = as.factor(year)))
