scale_pattern_manual(values = c(Burned = "stripe", Unburned = "none"),
name = "") +
scale_x_discrete(
limits = c("POKE", "CARI", "STRT", "FRCH", "MOOS", "VAUL"),
labels = c(POKE = "POKE\n(25%)",
CARI = "CARI\n(29%)",
