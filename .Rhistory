hi.spc.frch.lmer <- AMC %>% filter(site.ID == "FRCH" & response_var == "SPC") %>%
lmer(ln_HI ~ precip.week_z + precip.month_z + TimeSinceChena_cent + Intensity_z + (1|year), data = .)
