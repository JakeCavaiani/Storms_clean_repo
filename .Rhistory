ggplot(AMC_new, aes(x = site.ID, y = sdBETA, pattern = burn, fill = site.ID)) +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
geom_boxplot() +
ylim(-0.4, 2.5) +
geom_boxplot_pattern(
position = position_dodge(preserve = "single"),
color = "black",
pattern_fill = "white",
pattern_angle = 45,
pattern_density = 0.1,
pattern_spacing = 0.025,
pattern_key_scale_factor = 0.6
) +
scale_pattern_manual(
values = c(burned = "stripe", unburned = "none"),
name = "Burn History", # Update the legend title
labels = c("Burned", "Unburned")) + # Update the legend values +
scale_fill_manual(values = c("#A6761D", "#66C2A5", "#FF7F00", "#6A3D9A", "#3288BD", "#E7298A")) +
xlab("") +
ylab("Mean HI") +
theme_classic() +
facet_wrap(~response_var, labeller = my_labeller) +
geom_text(
data = AMC_new[AMC_new$response_var == "turb", ],
aes(x = Inf, y = 0, label = "Flushing"),
color = "black",
hjust = 4.3,
vjust = -0.5,
inherit.aes = FALSE
) +
geom_text(
data = AMC_new[AMC_new$response_var == "turb", ],
aes(x = Inf, y = -0.1, label = "Dilution"),
color = "black",
hjust = 2.5,
vjust = 1.5,
inherit.aes = FALSE
) +
geom_text(
data = stat_diff, # Use the statistical differences dataset
aes(x = site.ID, y = meanHI, label = label), # Map site.ID, y position, and letters
vjust = -0.5, # Position above the boxes
color = "black",
fontface = "bold",
size = 5,
inherit.aes = FALSE
) +
theme(
axis.text.x = element_text(size = 20, angle = 90, vjust = 0.5, hjust = 1),
axis.text.y = element_text(size = 20),
axis.title.x = element_text(size = 20),
axis.title.y = element_text(size = 20),
legend.position = c(0.12, 0.89),
legend.key = element_blank(), # Remove the white background for keys
legend.background = element_blank(), # Remove the background behind the legend
legend.box.background = element_blank(),
strip.text = element_text(size = 20)
) +
guides(fill = "none")
