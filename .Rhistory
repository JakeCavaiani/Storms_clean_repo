lmer(ln_HI ~ precip.week_z + precip.month_z + TimeSinceChena_cent + Intensity_z + (1|year), data = .)
hi.spc.poke.lmer <- AMC %>% filter(site.ID == "POKE" & response_var == "SPC" & ln_HI > 0) %>%
lmer(ln_HI ~ precip.month_z + TimeSinceChena_cent + Intensity_z + (1|year), data = .)
hi.spc.cari.lmer <- AMC %>% filter(site.ID == "CARI" & response_var == "SPC") %>%
lmer(ln_HI ~ precip.month_z + TimeSinceChena_cent + Intensity_z + (1|year), data = .)
