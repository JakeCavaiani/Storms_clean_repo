# HI fDOM ####
multi.coef <- dwplot(list(hi.fdom.moos.lmer, hi.fdom.frch.lmer, hi.fdom.cari.lmer, hi.fdom.poke.lmer, hi.fdom.strt.lmer, hi.fdom.vaul.lmer),
effects="fixed",
dot_args = list(size = 6),
whisker_args = list(size = 2)) +
scale_color_manual(labels = rev(c(bquote(paste("MOOS ", R^{2} == .(format(r.squaredGLMM(hi.fdom.moos.lmer)[[1]][1], digits = 2)), " n" == .(nobs(hi.fdom.moos.lmer)))),
bquote(paste("FRCH ", R^{2} == .(format(r.squaredGLMM(hi.fdom.frch.lmer)[[1]][1], digits = 2)), " n" == .(nobs(hi.fdom.frch.lmer)))),
bquote(paste("CARI ", R^{2} == .(format(r.squaredGLMM(hi.fdom.cari.lmer)[[1]][1], digits = 2)), " n" == .(nobs(hi.fdom.cari.lmer)))),
bquote(paste("POKE ", R^{2} == .(format(r.squaredGLMM(hi.fdom.poke.lmer)[[1]][1], digits = 2)), " n" == .(nobs(hi.fdom.poke.lmer)))),
bquote(paste("STRT ", R^{2} == .(format(r.squaredGLMM(hi.fdom.strt.lmer)[[1]][1], digits = 2)), " n" == .(nobs(hi.fdom.strt.lmer)))),
bquote(paste("VAUL ", R^{2} == .(format(r.squaredGLMM(hi.fdom.vaul.lmer)[[1]][1], digits = 2)),  " n" == .(nobs(hi.fdom.vaul.lmer)))))),
values = c("#E7298A", "#66C2A5", "#6A3D9A", "#3288BD", "#FF7F00", "#A6761D"), drop = FALSE) +
geom_vline(xintercept=0, lty=2) +
xlab("effect size") +
xlim(-0.4, 0.5) +
scale_y_discrete(labels=c(precip.week_z = "ppt 1 week", precip.month_z = "ppt 1 month", Intensity_z = "ppt event intensity", TimeSinceChena_z = "days since snowmelt")) +
theme_bw() +
theme(legend.position = c(0.78, 0.38),
legend.title = element_blank(),
legend.text = element_text(size = 18),
legend.background = element_blank(),
legend.box.background = element_rect(color = "black", size = 1),
plot.title = element_text(face = "bold", hjust = 0.5, size =22),
panel.grid = element_blank(),
panel.border = element_rect(color = "black", size = 2),
axis.text = element_text(size = 22),
axis.title.x = element_text(size = 22),
plot.margin = margin(0.5,1.5,0.5,0.5, "cm"))
ggsave(multi.coef, path = here("plots", "Coefficient_Plots"),
file = paste0("FigX_HI_fdom_coef_", Sys.Date(), ".pdf"),
width = 10, height = 8, units = "in")
