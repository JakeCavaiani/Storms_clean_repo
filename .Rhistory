storm_char_all <- full_join(AMCsumm_all, Catch_charz, by = "site")
names(AMC)[names(AMC) == 'site.ID'] <- 'site'
## Summarize storm C-Q
# by year
AMCsumm_y <- AMC %>% dplyr::select(site, year, response_var, Hyst_index, Flush_index, Beta_index) %>%
group_by(site.ID, year, response_var) %>%
summarize(n = n(),
across(c(Hyst_index, Flush_index, Beta_index), list(mn = mean, md = median, SD = sd), na.rm = TRUE)) %>%
mutate(CVhi = Hyst_index_SD/Hyst_index_mn) %>%
mutate(CVbeta = Beta_index_SD/Beta_index_mn) %>%
mutate(seHI = Hyst_index_mn/sqrt(n)) %>%
mutate(seBETA = Beta_index_mn/sqrt(n))
## Summarize storm C-Q
# by year
AMCsumm_y <- AMC %>% dplyr::select(site, year, response_var, Hyst_index, Flush_index, Beta_index) %>%
group_by(site, year, response_var) %>%
summarize(n = n(),
across(c(Hyst_index, Flush_index, Beta_index), list(mn = mean, md = median, SD = sd), na.rm = TRUE)) %>%
mutate(CVhi = Hyst_index_SD/Hyst_index_mn) %>%
mutate(CVbeta = Beta_index_SD/Beta_index_mn) %>%
mutate(seHI = Hyst_index_mn/sqrt(n)) %>%
mutate(seBETA = Beta_index_mn/sqrt(n))
# across years
AMCsumm_all <- AMC %>% dplyr::select(site, year, response_var, Hyst_index, Flush_index, Beta_index) %>%
group_by(site, response_var) %>%
summarize(n = n(),
across(c(Hyst_index, Flush_index, Beta_index), list(mn = mean, md = median, SD = sd), na.rm = TRUE)) %>%
mutate(CVhi = Hyst_index_SD/Hyst_index_mn) %>%
mutate(CVbeta = Beta_index_SD/Beta_index_mn) %>%
mutate(seHI = Hyst_index_mn/sqrt(n)) %>%
mutate(seBETA = Beta_index_mn/sqrt(n))
rm(storm_char_y)
rm(storm_char_all)
storm_char_y <- full_join(AMCsumm_y, Catch_charz, by = "site")
storm_char_all <- full_join(AMCsumm_all, Catch_charz, by = "site")
storm_char_y %>% filter(response_var == "NO3") %>% ggpairs(
columns = c("Hyst_index_mn", "Hyst_index_SD", "Beta_index_mn", "Beta_index_SD", "SLOPE_MEAN", "cburntot", "pctburn_lg", "Pf_Prob_1m_mean_x", "NDVI_p50__mean", "deciduous2010", "deciduous2016", "deciduous2020", "evergreen"),
