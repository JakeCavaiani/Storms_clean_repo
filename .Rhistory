geom_boxplot() +
scale_fill_manual(values = c("#3288BD", "#FF7F00","#A6761D", "#6A3D9A", "#66C2A5", "#E7298A")) +
theme_classic()
NO3.CV.HI.mod <- lmer(meanHI ~ site.ID + (1|year), data = HI_FI_NO3)
