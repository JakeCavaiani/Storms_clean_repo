## Permafrost cover from Jorgenson et al. 2025. Caribou estimated from NRDS geomorphic units by A. Wright
# CARI:
# FRCH: 32.9
# MOOS: 38.4
# POKE: 25.3
# STRT: 30.8
# VAUL: 58.4
Catchment_characteristics <- Catchment_characteristics %>%
mutate(deciduous2010 = ifelse(site == "Vault", 18.58,
ifelse(site == "Caribou_CJ", 18.20,
ifelse(site == "Stuart", 24.73,
ifelse(site == "Moose", 28.25,
ifelse(site == "French", 21.85, 20.16)))))) %>%
mutate(deciduous2016 = ifelse(site == "Vault", 20.6,
ifelse(site == "Caribou_CJ", 22.5,
ifelse(site == "Stuart", 16.9,
ifelse(site == "Moose", 21.6,
ifelse(site == "French", 29.6, 27.3)))))) %>%
mutate(deciduous2020 = ifelse(site == "Vault", 18.77,
ifelse(site == "Caribou_CJ", 18.32,
ifelse(site == "Stuart", 19.86,
ifelse(site == "Moose", 22.65,
ifelse(site == "French", 22.49, 21.61)))))) %>%
mutate(evergreen = ifelse(site == "Vault", 50.8,
ifelse(site == "Caribou_CJ", 51.9,
ifelse(site == "Stuart", 15.2,
ifelse(site == "Moose", 10.3,
ifelse(site == "French", 53.4, 30.5)))))) %>%
mutate(NDVIave = ifelse(site == "Caribou_CJ", 0.211,
ifelse(site == "French", 0.213,
ifelse(site == "Moose", 0.229,
ifelse(site == "Poker_CJ", 0.232,
ifelse(site == "Stuart", 0.256, 0.228)))))) %>%
mutate(pfrost = ifelse(site == "French", 32.9,
ifelse(site == "Moose", 38.4,
ifelse(site == "Poker_CJ", 25.3,
ifelse(site == "Stuart", 30.8,
ifelse(site == "Vault", 58.4, NA))))))
