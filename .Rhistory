scale_color_manual(labels = rev(c(bquote(paste("MOOS ", R^{2} == .(format(r.squaredGLMM(beta.spc.moos.lmer)[[1]][1], digits = 2)), " n" == .(nobs(beta.spc.moos.lmer)))),
bquote(paste("FRCH ", R^{2} == .(format(r.squaredGLMM(beta.spc.frch.lmer)[[1]][1], digits = 2)), " n" == .(nobs(beta.spc.frch.lmer)))),
bquote(paste("CARI ", R^{2} == .(format(r.squaredGLMM(beta.spc.cari.lmer)[[1]][1], digits = 2)), " n" == .(nobs(beta.spc.cari.lmer)))),
bquote(paste("POKE ", R^{2} == .(format(r.squaredGLMM(beta.spc.poke.lmer)[[1]][1], digits = 2)), " n" == .(nobs(beta.spc.poke.lmer)))),
bquote(paste("STRT ", R^{2} == .(format(r.squaredGLMM(beta.spc.strt.lmer)[[1]][1], digits = 2)), " n" == .(nobs(beta.spc.strt.lmer)))),
bquote(paste("VAUL ", R^{2} == .(format(r.squaredGLMM(beta.spc.vaul.lmer)[[1]][1], digits = 2)),  " n" == .(nobs(beta.spc.vaul.lmer)))))),
values = c("#E7298A", "#66C2A5", "#6A3D9A", "#3288BD", "#FF7F00", "#A6761D"), drop = FALSE) +
geom_vline(xintercept=0, lty=2) +
xlab("effect size") +
xlim(-0.1, 0.1) +
